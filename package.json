{
  "name": "ai-browser-agent-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local AI browser agent lab: generated storefront images and a Browser Use Pi agent.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && tsx scripts/run-next.ts dev",
    "build": "node scripts/check-node.mjs && tsx scripts/run-next.ts build",
    "start": "node scripts/check-node.mjs && tsx scripts/run-next.ts start",
    "lint": "eslint .",
    "typecheck": "node scripts/check-node.mjs && NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:runtime": "node scripts/check-node.mjs",
    "smoke:browser-local": "node scripts/check-node.mjs && tsx scripts/browser-smoke.ts",
    "test:e2e": "node scripts/check-node.mjs && node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@browser_use/pi": "0.1.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
